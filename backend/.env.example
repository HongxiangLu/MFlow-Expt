ENV=local

# ============================================================
# M-Flow RAG 引擎配置（由 M-Flow 库通过 load_dotenv() 自动读取）
# ============================================================

# 大语言模型调用（M-Flow 内部使用）
LLM_API_KEY=sk-你的MINIMAX_API_KEY
LLM_PROVIDER=custom
LLM_MODEL=openai/MiniMax-M2.7
LLM_ENDPOINT=https://api.minimax.chat/v1

# 向量模型调用
EMBEDDING_API_KEY=jina_你的JINA_API_KEY
EMBEDDING_PROVIDER=custom
EMBEDDING_MODEL=jina_ai/jina-embeddings-v3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_ENDPOINT=https://api.jina.ai/v1

# M-Flow 关系型数据库设置
DB_PROVIDER=sqlite
DB_NAME=experiment_mflow

# M-Flow 向量数据库设置
VECTOR_DB_PROVIDER=lancedb

# M-Flow 图数据库设置
GRAPH_DATABASE_PROVIDER=kuzu

# M-Flow 数据存放目录（绝对路径）
DATA_ROOT_DIRECTORY=你的项目目录/backend/.runtime/data
SYSTEM_ROOT_DIRECTORY=你的项目目录/backend/.runtime/system

# ============================================================
# 后端应用配置（由 pydantic-settings BaseSettings 管理）
# ============================================================

# 后端 LLM 调用（用于 Query Rewrite 和对话生成）
MINIMAX_API_KEY=sk-你的MINIMAX_API_KEY
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=MiniMax-M2.7

# 后端 SQLite 数据库路径
BACKEND_DB_PATH=./.runtime/backend.db

# Uvicorn 服务配置
# APP_HOST=0.0.0.0
# APP_PORT=8000