ENV=local

# 大语言模型调用
LLM_API_KEY=sk-你的MINIMAX_API_KEY
LLM_PROVIDER=custom
LLM_MODEL=openai/MiniMax-M2.7
LLM_ENDPOINT=https://api.minimax.chat/v1

# 向量模型调用
EMBEDDING_API_KEY=jina_你的JINA_API_KEY
EMBEDDING_PROVIDER=custom
EMBEDDING_MODEL=jina_ai/jina-embeddings-v3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_ENDPOINT=https://api.jina.ai/v1

# 关系型数据库设置
DB_PROVIDER=sqlite
DB_NAME=experiment_mflow

# 向量数据库设置
VECTOR_DB_PROVIDER=lancedb

# 图数据库设置
GRAPH_DATABASE_PROVIDER=kuzu

# 数据存放目录（绝对路径）
DATA_ROOT_DIRECTORY=你的项目目录/backend/.data
SYSTEM_ROOT_DIRECTORY=你的项目目录/backend/.system